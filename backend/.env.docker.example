# Copy to backend/.env.docker and fill all required values.
POSTGRES_PASSWORD=change-me
DATABASE_SYNC=true

NETWORK=testnet
ZG_ROUTER_NETWORK=testnet
ZG_ROUTER_API_KEY=sk-your-key
X402_NETWORK=testnet
X402_PAY_TO=YOUR_ALGORAND_ADDRESS
ADMIN_API_KEY=change-me

PUBLIC_APP_URL=http://localhost:3000
PUBLIC_CODE_URL=http://localhost:5000
PUBLIC_SITE_URL=http://localhost:4001
PUBLIC_API_URL=https://api.micropay.website
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
WS_CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# Optional storage and tools.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_BASE_URL=
TAVILY_API_KEY=

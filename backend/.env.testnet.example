# Testnet profile — copy to .env.testnet.local
NODE_ENV=development
PORT=4000
NETWORK=testnet

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/micropay
DATABASE_SYNC=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

ZG_ROUTER_NETWORK=testnet
ZG_ROUTER_API_KEY=sk-your-testnet-key

X402_NETWORK=testnet
X402_PAY_TO=YOUR_TESTNET_ALGORAND_ADDRESS
DEFAULT_AMOUNT=0.01

TOOLS_ENABLED=true
TAVILY_API_KEY=

ADMIN_API_KEY=dev-admin-key
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_CODE_URL=http://localhost:5000

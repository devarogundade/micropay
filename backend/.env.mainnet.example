# Mainnet profile — copy to .env.mainnet.local (never commit secrets)
NODE_ENV=production
PORT=4000
NETWORK=mainnet

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/micropay?sslmode=require
DATABASE_SYNC=false
DATABASE_SSL=true

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=micropay-prod

ZG_ROUTER_NETWORK=mainnet
ZG_ROUTER_API_KEY=sk-your-mainnet-key

X402_NETWORK=mainnet
X402_PAY_TO=YOUR_MAINNET_ALGORAND_ADDRESS
DEFAULT_AMOUNT=0.05

TOOLS_ENABLED=true
TAVILY_API_KEY=

ADMIN_API_KEY=
PUBLIC_APP_URL=https://app.micropay.website
PUBLIC_CODE_URL=https://code.micropay.website
PUBLIC_SITE_URL=https://micropay.website
PUBLIC_API_URL=https://api.micropay.website

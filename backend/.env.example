# Micropay NestJS backend — shared API for `app` + `code` frontends.
#
# Dual network: set NETWORK=testnet|mainnet (or use .env.testnet / .env.mainnet).
# Loaded order: .env.{NETWORK}.local → .env.{NETWORK} → .env.local → .env

NODE_ENV=development
PORT=4000
NETWORK=testnet

# ── PostgreSQL (TypeORM) ─────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/micropay
# Dev only — prefer migrations in production
DATABASE_SYNC=true
DATABASE_LOGGING=false
DATABASE_SSL=false

# ── Redis / BullMQ ───────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0

# ── AWS S3 ───────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=micropay
# AWS_S3_ENDPOINT=   # optional (MinIO / LocalStack)
# AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com

# Legacy Supabase (optional during migration)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=micropay

# ── 0G Compute Router ────────────────────────────────────────
ZG_ROUTER_NETWORK=testnet
ZG_ROUTER_API_KEY=sk-your-key-here
# ZG_ROUTER_BASE_URL=
# ZG_ROUTER_MANAGEMENT_KEY=

# ── x402 / Algorand ──────────────────────────────────────────
# Single merchant for both app (chat/images/audio) and code (IDE/clone)
X402_NETWORK=testnet
X402_PAY_TO=YOUR_ALGORAND_ADDRESS_58_CHARS
# X402_FEE_PAYER=

# Fallback USDC when a model/template has no admin PricingRule override
DEFAULT_AMOUNT=0.01

# ── Chat tools (OpenAI function-calling via 0G router) ───────
TOOLS_ENABLED=true
TOOLS_MAX_ROUNDS=4
TOOLS_WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=
TOOLS_PDF_EXTRACT_ENABLED=true
TOOLS_FETCH_URL_ENABLED=true
TOOLS_KNOWLEDGE_SEARCH_ENABLED=true
TOOLS_CURRENT_TIME_ENABLED=true
TOOLS_JSON_EXTRACT_ENABLED=true

# ── Admin ────────────────────────────────────────────────────
ADMIN_API_KEY=change-me-admin-key

# ── Public origins / CORS ────────────────────────────────────
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_CODE_URL=http://localhost:5000
PUBLIC_SITE_URL=http://localhost:5173
# Public HTTPS origin used in x402 payment challenges and Bazaar records.
PUBLIC_API_URL=https://api.micropay.website
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
WS_CORS_ORIGIN=*

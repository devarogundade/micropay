// Micropay app — product-owned Prisma schema.
// Same DATABASE_URL Postgres instance as code/ is OK, but models/tables are
// completely separate: this schema must NEVER include Code* / IDE tables.
// Migrations: app/prisma/migrations (app tables only).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Wallet-keyed user (Algorand address).
model User {
  id               String            @id
  address          String            @unique
  displayName      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  activities       Activity[]
  chatSessions     ChatSession[]
  imageGenerations ImageGeneration[]
  imageJobs        ImageJob[]
  transcriptions   Transcription[]
  modelUsage       UserModelUsage[]
}

enum ActivityStatus {
  settled
  verified
  failed
}

/// Settled / failed paid API usage event.
model Activity {
  id            String         @id @default(cuid())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  walletAddress String?
  modelSlug     String
  modelName     String
  type          String
  costUsdc      Float
  status        ActivityStatus
  txId          String
  requestId     String?
  provider      String?
  tokensIn      Int?
  tokensOut     Int?
  createdAt     DateTime       @default(now())

  @@index([createdAt])
  @@index([walletAddress, createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@index([type])
}

/// Per-wallet conversation for a model workspace.
model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId   String
  modelSlug String?
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@index([userId, modelId, updatedAt])
}

model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String
  content     String
  /// Attachment metadata: id/name/mime|mimeType/size/kind + storagePath/url (Supabase); no data URLs.
  attachments Json?
  reasoning   String?
  modelId     String?
  costUsdc    Float?
  provider    String?
  error       Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([sessionId, createdAt])
}

/// Persisted image generation (Supabase URL + prompt meta), keyed by wallet user.
model ImageGeneration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelSlug   String
  modelName   String?
  prompt      String
  size        String?
  url         String
  storagePath String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Async image job metadata (paid at submit; status streamed via SSE).
model ImageJob {
  id              String   @id
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  walletAddress   String?
  modelSlug       String
  modelName       String?
  prompt          String
  size            String?
  providerAddress String?
  status          String   @default("queued")
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

/// Per-wallet model usage for Recently Used (updated on successful paid settle).
model UserModelUsage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelSlug  String
  modelName  String?
  lastUsedAt DateTime @default(now())
  useCount   Int      @default(1)

  @@unique([userId, modelSlug])
  @@index([userId, lastUsedAt])
}

/// Persisted audio transcription (text + source file meta), keyed by wallet user.
model Transcription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelSlug String
  modelName String?
  filename  String?
  mimeType  String?
  fileSize  Int?
  language  String?
  text      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

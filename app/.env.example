# Database URL for PostgreSQL (Prisma — required for activities, stats, chat history)
#
# Production: Netlify DB (Neon). Copy the connection string from the Netlify
# project → Extensions → Neon / Database, or use the auto-injected DATABASE_URL
# on Netlify deploys.
#
#   postgresql://USER:PASSWORD@ep-xxx.us-east-2.db.netlify.com/netlifydb?sslmode=require
#
# Local: put the real URL in .env.local (preferred). `npm run dev` and `db:*`
# load .env.local via dotenv-cli. After changing DATABASE_URL, restart `dev`.
#
# TLS: getPgPoolConfig() uses the platform trust store (no custom CA).
# Prefer omitting sslmode from the URL for PrismaPg/node-postgres — `pg` can
# map sslmode=require oddly; SSL is enabled in code via PoolConfig.ssl.
#
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"

# ── 0G Compute Router (server-side only) ─────────────────────────────
# Docs: https://docs.0g.ai/developer-hub/building-on-0g/compute-network/router/overview
#
# Create an sk- inference key at:
#   Mainnet: https://pc.0g.ai
#   Testnet: https://pc.testnet.0g.ai
#
# Do NOT put sk-/mk- keys in VITE_* vars (they would ship to the browser).

# Optional override. Defaults from ZG_ROUTER_NETWORK below.
# ZG_ROUTER_BASE_URL="https://router-api.0g.ai/v1"
# Testnet: https://router-api-testnet.integratenetwork.work/v1

ZG_ROUTER_NETWORK="mainnet"
ZG_ROUTER_API_KEY="sk-your-key-here"

# mk- management keys are for /v1/account/* admin only — not required for inference.
# ZG_ROUTER_MANAGEMENT_KEY="mk-your-key-here"

# ── x402 / Algorand micropayments (server-side) ──────────────────────
# Pay / use price is computed per model in code (zg-catalog.ts) in the
# 0.01–0.03 USDC band (MIN_PAY_USDC / MAX_PAY_USDC + modelMinPayUsdc in
# data/models.ts). No PRICE env override.
# Algorand x402 Global Challenge (dual merchant cards OK):
#   - Settle via GoPlausible facilitator only (not a local/custom facilitator)
#   - App paid routes (chat / images / audio) record into app Activity (app/prisma)
#   - IDE spend/templates live on code product tables (CodeActivity, CodeTemplate*)
#     — completely separate Prisma schema/migrations; never share app Activity rows
#   - Same DATABASE_URL Postgres instance is OK; zero shared table names/models
#   - IDE may use its own X402_PAY_TO / merchant on code.micropay.website
#   - Bazaar discovery + tag "x402-global-challenge" are set in code
#   - Production must be public HTTPS — localhost settlements do not count
#
# Mainnet (competition / leaderboard):
#   X402_NETWORK=mainnet
#   network = algorand:<ALGORAND_MAINNET_GENESIS_HASH> (matches GoPlausible /supported)
#   USDC ASA = 31566704
#   payTo must be opted in to USDC ASA 31566704
#
# Testnet (validation only — does not count toward the leaderboard):
#   X402_NETWORK=testnet
#   network = algorand:<ALGORAND_TESTNET_GENESIS_HASH>
#   USDC ASA = 10458941
#   payTo must be opted in to USDC ASA 10458941 (+ test ALGO/USDC from dispensers)

# Merchant address that receives USDC (58-char Algorand address).
# Without this, paywalled routes return 503 config_error (never fake success).
# Keep the same payTo for the whole competition (leaderboard attribution).
X402_PAY_TO="YOUR_ALGORAND_ADDRESS_58_CHARS"

# mainnet (default, required for challenge) or testnet — must match wallet + USDC ASA.
X402_NETWORK="mainnet"

# GoPlausible hosted facilitator (default). Same URL for Mainnet and Testnet.
# Do not point this at a local/custom facilitator for the challenge.
# X402_FACILITATOR_URL="https://facilitator.goplausible.xyz"

# GoPlausible fee payer for gasless AVM groups (optional override).
# Default matches facilitator GET /supported (Mainnet + Testnet):
#   ZMFK2OI7ZBD2U27ISERZC4S6LKM6WMFJPZQ4MYNJDZ2VNBNMBA67RA22AA
# X402_FEE_PAYER="ZMFK2OI7ZBD2U27ISERZC4S6LKM6WMFJPZQ4MYNJDZ2VNBNMBA67RA22AA"

# ── Public site origins ──────────────────────────────────────────────
# App and IDE are separate product surfaces. Same DATABASE_URL Postgres is OK;
# Prisma schemas/migrations/tables are completely separate (app/* vs Code*).
#
# Apex marketing:
# PUBLIC_SITE_URL="https://micropay.website"
# VITE_PUBLIC_SITE_URL="https://micropay.website"
#
# App product surface (this deploy):
# PUBLIC_APP_URL="https://app.micropay.website"
# VITE_PUBLIC_APP_URL="https://app.micropay.website"
#
# IDE product (separate Netlify site + GoPlausible merchant; own code/prisma):
# PUBLIC_CODE_URL="https://code.micropay.website"
# VITE_PUBLIC_CODE_URL="https://code.micropay.website"
#
# Legacy single-site: set only PUBLIC_APP_URL to your one domain.
# Netlify also sets URL / DEPLOY_PRIME_URL automatically as fallbacks.
# PUBLIC_APP_URL="https://your-domain.com"
# VITE_PUBLIC_APP_URL="https://your-domain.com"

# ── Browser wallet network hint (optional, public) ───────────────────
# Must match X402_NETWORK so the wallet signs on the same chain.
# VITE_X402_NETWORK="mainnet"

# Optional Algod endpoint for puya-ts IDE LocalNet deploy (overrides localhost:4001).
# MainNet / TestNet are chosen in the IDE network selector (AlgoNode by default).
# VITE_ALGOD_SERVER="http://localhost:4001"
# VITE_ALGOD_TOKEN="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
# VITE_ALGOD_PORT=""

# GitHub for the IDE is browser-local only (no server OAuth).
# Users paste a PAT in the IDE GitHub dialog → stored in localStorage as
# micropay.ide.github.pat.v1. Fine-grained: Contents Read (+ Write to push).
# There is no GITHUB_TOKEN server env — do not add one unless you build OAuth.

# ── Supabase Storage (server-side uploads, 50 MB hard limit) ─────────
# Micropay enforces MAX_UPLOAD_BYTES = 50 MB in storage-limits.ts.
# Raise the bucket file size limit in Supabase Dashboard → Storage →
# Configuration if the project default is lower than 50 MB.
# Project URL + service role key from Supabase → Project Settings → API.
# Never put SUPABASE_SERVICE_ROLE_KEY in VITE_* (it bypasses RLS).
#
# Bucket setup (Dashboard → Storage → New bucket, name: micropay, Public: ON)
# or SQL:
#   insert into storage.buckets (id, name, public)
#   values ('micropay', 'micropay', true);
#
# Optional public-read policy (if not using a public bucket):
#   create policy "Public read micropay"
#   on storage.objects for select
#   using (bucket_id = 'micropay');

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="micropay"

# Browser direct uploads are not required (server upload preferred).
# Only add these if you later enable client-side signed uploads:
# VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-key"

# Required browser-visible NestJS API origin.
# The app has no database, server functions, API proxy routes, or backend secrets.
VITE_PUBLIC_API_URL="http://localhost:4000"

# Public product origins used for links and metadata.
VITE_PUBLIC_APP_URL="http://localhost:3000"
VITE_PUBLIC_SITE_URL="https://micropay.website"
VITE_PUBLIC_CODE_URL="http://localhost:5000"

# Public wallet network hint. Must match the backend payment configuration.
VITE_X402_NETWORK="testnet"

# Optional LocalNet Algod settings for browser wallet deployment.
# VITE_ALGOD_SERVER="http://localhost:4001"
# VITE_ALGOD_TOKEN="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
# VITE_ALGOD_PORT=""

# Keep DATABASE_URL, provider keys, payment recipient configuration, storage
# credentials, admin keys, and every other secret in backend/.env.* only.

# Database URL for PostgreSQL (Prisma) — may match app/ connection string.
# Completely separate product tables/data (zero shared Prisma models/rows):
# - App owns: User, Activity, Chat*, Image*, Transcription, UserModelUsage
#   (app/prisma + Prisma Migrate)
# - Code owns: CodeUser, CodeActivity, CodeUserModelUsage, CodeTemplate, CodeTemplateClone
#   (code/prisma → Postgres schema `code`; apply with `npm run db:push`)
#
# Production: Netlify DB (Neon). Prefer Netlify-injected DATABASE_URL, or copy
# the connection string into .env.local for local `vite dev` / `db:*`.
#
# TLS: getPgPoolConfig() uses the platform trust store (no custom CA).
#
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"

# ── 0G Compute Router (server-side only) ─────────────────────────────
ZG_ROUTER_NETWORK="mainnet"
ZG_ROUTER_API_KEY="sk-your-key-here"

# ── x402 / Algorand (IDE merchant — may differ from app's X402_PAY_TO) ─
# Same GoPlausible facilitator + x402-global-challenge tag.
# Template clone: POST /api/v1/clone @ 0.05 USDC → CodeTemplateClone.
# Agent settlements: CodeActivity (never app Activity).
X402_PAY_TO="YOUR_ALGORAND_ADDRESS_58_CHARS"
X402_NETWORK="mainnet"
# X402_FACILITATOR_URL="https://facilitator.goplausible.xyz"

# ── Public origins ───────────────────────────────────────────────────
# PUBLIC_SITE_URL="https://micropay.website"
# VITE_PUBLIC_SITE_URL="https://micropay.website"
# PUBLIC_APP_URL="https://app.micropay.website"
# VITE_PUBLIC_APP_URL="https://app.micropay.website"
# PUBLIC_CODE_URL="https://code.micropay.website"
# VITE_PUBLIC_CODE_URL="https://code.micropay.website"

# Optional: force API host (default = same-origin Start routes)
# VITE_PUBLIC_API_URL="http://localhost:5000"

# VITE_X402_NETWORK="mainnet"

# Optional Algod for LocalNet deploy
# VITE_ALGOD_SERVER="http://localhost:4001"
# VITE_ALGOD_TOKEN="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
